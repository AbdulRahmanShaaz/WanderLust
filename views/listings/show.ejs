<%
layout('layouts/boilerplate');
  pageTitle = `WanderLust | ${listing.title}`;
  pageCss = '/css/listings/show.css';
  pageScript = '/js/listings/show.js';
%>
<% const priceValue = Number(listing.price); const formattedPrice = !Number.isNaN(priceValue) ? priceValue.toLocaleString('en-IN') : 'N/A'; %>
<%
  const reviews = typeof visibleReviews !== 'undefined' ? visibleReviews : (listing.reviews || []);
  const visibleReviewCount = reviews.length;
  const reviewCount = typeof totalReviews !== 'undefined' ? totalReviews : visibleReviewCount;
  const visibleLimit = Math.min(4, typeof reviewDisplayLimit !== 'undefined' ? reviewDisplayLimit : 4);
  const latestReviews = reviews.slice(0, visibleLimit);
  const ratingLabel = typeof averageRating !== 'undefined' ? averageRating : 'New';
%>

<div class="listing-container">
  <div class="listing-header">
    <h1><%= listing.title %></h1>
    <div class="listing-header-meta">
      <div class="meta-left">
        <span class="rating-star"><i class="fa-solid fa-star"></i> <%= ratingLabel %></span>
        <% if(reviewCount > 0) { %>
          <span class="meta-dot">·</span>
          <a href="#reviews" class="review-link"><%= reviewCount %> review<%= reviewCount === 1 ? '' : 's' %></a>
        <% } %>
        <span class="meta-dot">·</span>
        <span class="location-link"><i class="fa-solid fa-location-dot"></i> <%= listing.location %>, <%= listing.country %></span>
      </div>
      <div class="meta-right">
        <a href="/listings" class="share-btn"><i class="fa-solid fa-arrow-left"></i> Back to listings</a>
      </div>
    </div>
  </div>

  <section class="listing-gallery">
    <% const defaultImage = 'https://images.unsplash.com/photo-1625505826533-5c80aca7d157?ixlib=rb-4.0.3&auto=format&fit=crop&w=1200&q=80'; const listingImage = listing.image && listing.image.url ? listing.image.url : listing.image; %>
    <img src="<%= listingImage || defaultImage %>" alt="<%= listing.title %>" onerror="this.onerror=null;this.src='<%= defaultImage %>'" />
  </section>

  <div class="listing-body">
    <div class="listing-main">
      <div class="listing-host-summary section-divider">
        <div class="host-text">
          <h2>Entire home hosted by <%= listing.owner.username %></h2>
          <p>4 guests · 2 bedrooms · 2 beds · 1 bath</p>
        </div>
        <div class="host-avatar">
          <span><%= listing.owner.username.charAt(0).toUpperCase() %></span>
        </div>
      </div>

      <div class="listing-highlights section-divider">
        <div class="highlight-item">
          <i class="fa-solid fa-medal"></i>
          <div>
            <strong>Exceptional quality</strong>
            <p>Rated highly for cleanliness, comfort, and style.</p>
          </div>
        </div>
        <div class="highlight-item">
          <i class="fa-solid fa-location-crosshairs"></i>
          <div>
            <strong>Great location</strong>
            <p>100% of recent guests gave the location a 5-star rating.</p>
          </div>
        </div>
        <div class="highlight-item">
          <i class="fa-regular fa-calendar"></i>
          <div>
            <strong>Flexible cancellation</strong>
            <p>Free cancellation for 48 hours.</p>
          </div>
        </div>
      </div>

      <div class="listing-description section-divider">
        <h2 class="section-title">About this space</h2>
        <p><%= listing.description || 'This premium property offers an elevated stay experience with modern style, thoughtful amenities, and a location that feels both exclusive and effortlessly accessible.' %></p>
      </div>
      
      <div class="listing-reviews section-divider" id="reviews">
        <div class="reviews-header-main">
          <h2><i class="fa-solid fa-star"></i> <%= ratingLabel %> · <%= reviewCount %> review<%= reviewCount === 1 ? '' : 's' %></h2>
        </div>

        <div class="reviews-grid">
          <% if (latestReviews.length) { %>
            <% latestReviews.forEach((review, index) => { %>
              <div class="review-card">
                <div class="review-user">
                  <div class="user-avatar"><%= review.author.username.charAt(0).toUpperCase() %></div>
                  <div class="user-info">
                    <strong><%= review.author.username %></strong>
                    <span>
                      <% if (review.createdAt) { %>
                        <%= review.createdAt.toLocaleDateString('en-IN', { month: 'long', year: 'numeric' }) %>
                      <% } else { %>
                        Recently
                      <% } %>
                    </span>
                  </div>
                </div>
                <div class="review-rating-stars">
                   <% for(let i=0; i<review.rating; i++) { %><i class="fa-solid fa-star"></i><% } %>
                </div>
                <p class="review-text"><%= review.comment %></p>
                <% if (currentUser && review.author._id.equals(currentUser._id)) { %>
                <form class="delete-review-form" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" method="POST">
                  <button class="delete-review-btn">Delete</button>
                </form>
                <% } %>
              </div>
            <% }) %>
          <% } else { %>
            <div class="empty-reviews">
              <p>No reviews yet. Be the first to leave one!</p>
            </div>
          <% } %>
        </div>

        <div class="add-review-section">
          <h3>Leave a review</h3>
          <form class="review-form" action="/listings/<%= listing._id %>/reviews" method="POST">
            <div class="rating-input">
              <label>Rating</label>
              <div class="star-rating">
                <input type="radio" id="star5" name="review[rating]" value="5" checked />
                <label for="star5" title="5 stars"><i class="fa-solid fa-star"></i></label>
                <input type="radio" id="star4" name="review[rating]" value="4" />
                <label for="star4" title="4 stars"><i class="fa-solid fa-star"></i></label>
                <input type="radio" id="star3" name="review[rating]" value="3" />
                <label for="star3" title="3 stars"><i class="fa-solid fa-star"></i></label>
                <input type="radio" id="star2" name="review[rating]" value="2" />
                <label for="star2" title="2 stars"><i class="fa-solid fa-star"></i></label>
                <input type="radio" id="star1" name="review[rating]" value="1" />
                <label for="star1" title="1 star"><i class="fa-solid fa-star"></i></label>
              </div>
            </div>
            <div class="review-input">
              <label for="comment">Comment</label>
              <textarea id="comment" name="review[comment]" rows="4" minlength="5" required placeholder="Share your experience..."></textarea>
            </div>
            <button class="btn-primary">Submit Review</button>
          </form>
        </div>
      </div>
    </div>

    <div class="listing-sidebar">
      <div class="booking-widget">
        <div class="widget-header">
          <div class="price-info">
            <span class="price">₹<%= formattedPrice %></span>
            <span class="night">night</span>
          </div>
        </div>

        <div class="booking-inputs">
          <div class="dates">
            <div class="check-in">
              <label>CHECK-IN</label>
              <span>Add date</span>
            </div>
            <div class="check-out">
              <label>CHECKOUT</label>
              <span>Add date</span>
            </div>
          </div>
          <div class="guests">
            <label>GUESTS</label>
            <span>1 guest</span>
          </div>
        </div>

        <button class="btn-primary reserve-btn">Reserve</button>
        <p class="charge-notice">You won't be charged yet</p>
        
        <% if (currentUser && listing.owner._id.equals(currentUser._id)) { %>
        <div class="admin-actions">
          <p class="admin-label">Host Actions</p>
          <div class="action-buttons">
            <a href="/listings/<%= listing._id %>/edit" class="btn-secondary">Edit</a>
            <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST" data-delete-form>
              <button type="submit" class="btn-danger">Delete</button>
            </form>
          </div>
        </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<div class="modal-backdrop" data-delete-modal hidden>
  <div class="confirm-dialog" role="dialog" aria-modal="true">
    <div class="confirm-icon">!</div>
    <div class="confirm-copy">
      <h2>Delete this listing?</h2>
      <p>This will permanently remove "<%= listing.title %>" and its reviews.</p>
    </div>
    <div class="confirm-actions">
      <button type="button" class="btn-secondary" data-cancel-delete>Cancel</button>
      <button type="button" class="btn-danger confirm-delete-btn" data-confirm-delete>Delete</button>
    </div>
  </div>
</div>
