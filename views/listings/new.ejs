<%
layout('layouts/boilerplate');
  pageTitle = 'WanderLust | List Your Place';
  pageCss = '/css/listings/form.css';
  pageScript = '/js/form-validation.js';
%>
<main class="form-page-container">
  <div class="form-header-wrapper">
    <span class="eyebrow">Host onboarding</span>
    <h1>List a stay guests will remember</h1>
    <p>Create a polished listing with the essentials travelers need to trust, compare, and book your place with confidence.</p>
  </div>

  <div class="form-card">
    <form action="/listings" method="POST" enctype="multipart/form-data" class="premium-form validated-form" novalidate>
      
      <div class="field-group">
        <label for="title">Listing title</label>
        <input type="text" id="title" name="listing[title]" placeholder="Oceanfront villa with private deck" required minlength="5" />
        <span class="field-hint">Make it specific and easy to scan.</span>
      </div>

      <div class="field-group">
        <label for="description">Description</label>
        <textarea id="description" name="listing[description]" placeholder="Describe the space, guest experience, nearby highlights, and what makes it memorable." required minlength="20"></textarea>
        <span class="field-hint">Mention the setting, comfort, privacy, and standout details.</span>
      </div>

      <div class="form-row split">
        <div class="field-group">
          <label for="location">Location</label>
          <input type="text" id="location" name="listing[location]" placeholder="Goa" required />
        </div>
        <div class="field-group">
          <label for="country">Country</label>
          <input type="text" id="country" name="listing[country]" placeholder="India" required />
        </div>
      </div>

      <div class="field-group">
        <label for="price">Price per night</label>
        <input type="number" id="price" name="listing[price]" placeholder="4500" required min="0" step="1" />
        <span class="field-hint">Enter the amount in rupees (₹).</span>
      </div>

      <div class="field-group">
        <label>What best describes your place?</label>
        <input type="hidden" id="category" name="listing[category]" value="" required />
        <div class="category-picker" id="categoryPicker">
          <button type="button" class="category-card" data-value="Beachfront">
            <div class="category-card-icon"><i class="fa-solid fa-umbrella-beach"></i></div>
            <span class="category-card-label">Beachfront</span>
          </button>
          <button type="button" class="category-card" data-value="City">
            <div class="category-card-icon"><i class="fa-solid fa-city"></i></div>
            <span class="category-card-label">City</span>
          </button>
          <button type="button" class="category-card" data-value="Mountain">
            <div class="category-card-icon"><i class="fa-solid fa-mountain-sun"></i></div>
            <span class="category-card-label">Mountain</span>
          </button>
          <button type="button" class="category-card" data-value="Countryside">
            <div class="category-card-icon"><i class="fa-solid fa-tractor"></i></div>
            <span class="category-card-label">Countryside</span>
          </button>
          <button type="button" class="category-card" data-value="Luxury">
            <div class="category-card-icon"><i class="fa-solid fa-gem"></i></div>
            <span class="category-card-label">Luxury</span>
          </button>
          <button type="button" class="category-card" data-value="Budget">
            <div class="category-card-icon"><i class="fa-solid fa-piggy-bank"></i></div>
            <span class="category-card-label">Budget</span>
          </button>
        </div>
        <span class="field-hint">Pick the one that guests would expect when booking your property.</span>
      </div>

      <div class="form-row split">
        <div class="field-group">
          <label for="image">Listing image</label>
          <label for="image" class="file-upload-label">
            <i class="fa-solid fa-upload"></i>
            <span>Choose listing image</span>
            <input type="file" id="image" name="image" accept="image/*" class="file-input-hidden" />
          </label>
          <span class="field-hint">Upload an image from your device (jpg, png, webp, etc.).</span>
        </div>
      </div>

      <div class="form-actions">
        <a href="/listings" class="btn-secondary">Cancel</a>
        <button type="submit" class="btn-primary">Create listing</button>
      </div>

    </form>
  </div>
</main>
