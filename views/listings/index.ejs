<%
layout('layouts/boilerplate');
  pageTitle = 'WanderLust | Premium Stays';
  pageCss = '/css/listings/index.css';
  pageScript = '/js/listings/filters.js';
  navActionHref = '/listings/new';
  navActionLabel = 'List your place';
  footerText = 'WanderLust — curated stays inspired by Airbnb.';
  
  const searchQuery = search || '';
  const selectedCategory = category || '';
  const showTaxesFlag = (showTaxes || 'false') === 'true';

  // Count active filters for badge
  let activeFilterCount = 0;
  if (minPrice) activeFilterCount++;
  if (maxPrice) activeFilterCount++;
  if (showTaxesFlag) activeFilterCount++;

  const categories = [
    { value: 'Beachfront',  label: 'Beach',       icon: 'fa-umbrella-beach' },
    { value: 'Mountain',    label: 'Mountains',    icon: 'fa-mountain-sun' },
    { value: 'City',        label: 'City',         icon: 'fa-city' },
    { value: 'Countryside', label: 'Countryside',  icon: 'fa-tractor' },
    { value: 'Luxury',      label: 'Luxury',       icon: 'fa-gem' },
    { value: 'Budget',      label: 'Budget',       icon: 'fa-piggy-bank' },
  ];
%>

<!-- ============ HERO ============ -->
<section class="hero">
  <div class="hero-background"></div>
  <div class="hero-overlay"></div>
  <div class="hero-content">
    <div class="hero-text">
      <h1>Find your perfect stay</h1>
      <p>Unique homes, curated for every kind of traveller.</p>
    </div>

    <form class="hero-search" id="heroSearchForm" action="/listings" method="GET">
      <div class="search-group">
        <label for="hero-search-input">Where</label>
        <input
          id="hero-search-input"
          type="text"
          name="search"
          placeholder="Search destinations..."
          value="<%= searchQuery %>"
          autocomplete="off"
        />
      </div>
      <div class="search-divider"></div>
      <div class="search-group">
        <label>Check in</label>
        <span>Add dates</span>
      </div>
      <div class="search-divider"></div>
      <div class="search-group">
        <label>Check out</label>
        <span>Add dates</span>
      </div>
      <div class="search-divider"></div>
      <div class="search-group">
        <label>Guests</label>
        <span>Add guests</span>
      </div>
      <!-- preserve active filters when searching -->
      <% if (selectedCategory) { %><input type="hidden" name="category" value="<%= selectedCategory %>" /><% } %>
      <% if (minPrice) { %><input type="hidden" name="minPrice" value="<%= minPrice %>" /><% } %>
      <% if (maxPrice) { %><input type="hidden" name="maxPrice" value="<%= maxPrice %>" /><% } %>
      <% if (showTaxesFlag) { %><input type="hidden" name="showTaxes" value="true" /><% } %>
      <button type="submit" class="search-btn" aria-label="Search">
        <i class="fa-solid fa-magnifying-glass"></i>
        <span>Search</span>
      </button>
    </form>
  </div>
</section>

<!-- ============ CATEGORY STRIP ============ -->
<div class="category-strip-wrapper">
  <div class="category-strip" role="navigation" aria-label="Filter by category">
    <!-- All tab -->
    <a
      href="/listings?<%= searchQuery ? 'search=' + encodeURIComponent(searchQuery) + '&' : '' %><%= minPrice ? 'minPrice=' + minPrice + '&' : '' %><%= maxPrice ? 'maxPrice=' + maxPrice + '&' : '' %><%= showTaxesFlag ? 'showTaxes=true' : '' %>"
      class="category-tab <%= !selectedCategory ? 'active' : '' %>"
      title="All stays"
    >
      <i class="fa-solid fa-border-all"></i>
      <span>All</span>
    </a>

    <% categories.forEach(cat => { %>
    <a
      href="/listings?category=<%= cat.value %><%= searchQuery ? '&search=' + encodeURIComponent(searchQuery) : '' %><%= minPrice ? '&minPrice=' + minPrice : '' %><%= maxPrice ? '&maxPrice=' + maxPrice : '' %><%= showTaxesFlag ? '&showTaxes=true' : '' %>"
      class="category-tab <%= selectedCategory === cat.value ? 'active' : '' %>"
      title="<%= cat.label %>"
    >
      <i class="fa-solid <%= cat.icon %>"></i>
      <span><%= cat.label %></span>
    </a>
    <% }) %>

    <div class="category-strip-divider"></div>

    <!-- Filters + Tax toggle -->
    <div class="strip-controls">
      <button class="filters-toggle <%= activeFilterCount > 0 ? 'has-filters' : '' %>" id="filtersToggle" type="button">
        <i class="fa-solid fa-sliders"></i>
        Filters
        <% if (activeFilterCount > 0) { %>
          <span class="filters-badge"><%= activeFilterCount %></span>
        <% } %>
      </button>

      <form method="GET" action="/listings" id="taxPillForm">
        <% if (searchQuery) { %><input type="hidden" name="search" value="<%= searchQuery %>" /><% } %>
        <% if (selectedCategory) { %><input type="hidden" name="category" value="<%= selectedCategory %>" /><% } %>
        <% if (minPrice) { %><input type="hidden" name="minPrice" value="<%= minPrice %>" /><% } %>
        <% if (maxPrice) { %><input type="hidden" name="maxPrice" value="<%= maxPrice %>" /><% } %>
        <input type="hidden" name="showTaxes" id="taxPillHidden" value="<%= showTaxesFlag ? 'false' : 'true' %>" />
        <button type="submit" class="tax-pill" title="Toggle total price with taxes">
          <i class="fa-solid fa-receipt"></i>
          <span>Total<% if (showTaxesFlag) { %> ✓<% } %></span>
        </button>
      </form>
    </div>
  </div>
</div>

<!-- ============ MAIN CONTENT ============ -->
<main>
  <div class="content-wrapper">
    <% if (!listings || listings.length === 0) { %>
      <section class="empty-state">
        <i class="fa-solid fa-magnifying-glass" style="font-size:3rem;color:#ccc;margin-bottom:1rem;display:block;"></i>
        <h2>No stays found</h2>
        <p>Try adjusting your search or filters to find available stays.</p>
        <a href="/listings" class="btn-primary" style="display:inline-flex;align-items:center;gap:0.5rem;margin-top:1rem;">
          <i class="fa-solid fa-rotate-left"></i> Clear all filters
        </a>
      </section>
    <% } else { %>

      <!-- Active filters chips -->
      <% const hasAnyFilter = searchQuery || selectedCategory || minPrice || maxPrice || showTaxesFlag; %>
      <% if (hasAnyFilter) { %>
      <div class="active-filters">
        <% if (searchQuery) { %>
          <a class="filter-chip" href="/listings?<%= selectedCategory ? 'category=' + selectedCategory + '&' : '' %><%= minPrice ? 'minPrice=' + minPrice + '&' : '' %><%= maxPrice ? 'maxPrice=' + maxPrice + '&' : '' %><%= showTaxesFlag ? 'showTaxes=true' : '' %>">
            📍 <%= searchQuery %> <span class="remove-chip">×</span>
          </a>
        <% } %>
        <% if (selectedCategory) { %>
          <a class="filter-chip" href="/listings?<%= searchQuery ? 'search=' + encodeURIComponent(searchQuery) + '&' : '' %><%= minPrice ? 'minPrice=' + minPrice + '&' : '' %><%= maxPrice ? 'maxPrice=' + maxPrice + '&' : '' %><%= showTaxesFlag ? 'showTaxes=true' : '' %>">
            🏷️ <%= selectedCategory %> <span class="remove-chip">×</span>
          </a>
        <% } %>
        <% if (minPrice || maxPrice) { %>
          <a class="filter-chip" href="/listings?<%= searchQuery ? 'search=' + encodeURIComponent(searchQuery) + '&' : '' %><%= selectedCategory ? 'category=' + selectedCategory + '&' : '' %><%= showTaxesFlag ? 'showTaxes=true' : '' %>">
            💰 ₹<%= minPrice || '0' %> – ₹<%= maxPrice || '∞' %> <span class="remove-chip">×</span>
          </a>
        <% } %>
        <% if (showTaxesFlag) { %>
          <a class="filter-chip" href="/listings?<%= searchQuery ? 'search=' + encodeURIComponent(searchQuery) + '&' : '' %><%= selectedCategory ? 'category=' + selectedCategory + '&' : '' %><%= minPrice ? 'minPrice=' + minPrice + '&' : '' %><%= maxPrice ? 'maxPrice=' + maxPrice : '' %>">
            🧾 Total with taxes <span class="remove-chip">×</span>
          </a>
        <% } %>
        <a href="/listings" class="filter-chip" style="opacity:0.6;">Clear all ×</a>
      </div>
      <% } %>

      <div class="page-header">
        <div class="header-text">
          <p class="listing-count"><%= listings.length %> stay<%= listings.length === 1 ? '' : 's' %> available</p>
          <h2><%= selectedCategory ? selectedCategory + ' stays' : searchQuery ? 'Results for "' + searchQuery + '"' : 'Available stays' %></h2>
        </div>
      </div>

      <div class="layout">
        <!-- Filters Slide-in Panel -->
        <aside class="filters-panel" id="filtersPanel" role="dialog" aria-modal="true" aria-label="Filters">
          <div class="filters-header">
            <h3>Filters</h3>
            <button class="close-filters" id="closeFilters" aria-label="Close filters">
              <i class="fa-solid fa-xmark"></i>
            </button>
          </div>

          <form id="filtersForm" class="filters-form" action="/listings" method="GET">
            <% if (searchQuery) { %><input type="hidden" name="search" value="<%= searchQuery %>" /><% } %>
            <% if (selectedCategory) { %><input type="hidden" name="category" value="<%= selectedCategory %>" /><% } %>

            <!-- Price Range -->
            <div class="filter-section">
              <h4>Price range</h4>
              <p style="font-size:0.85rem;color:#717171;margin:0 0 1rem;">Nightly price in ₹ before taxes</p>
              <div class="price-range">
                <div class="price-input">
                  <label>Min price</label>
                  <input type="number" name="minPrice" placeholder="₹ 0" value="<%= minPrice || '' %>" min="0" />
                </div>
                <span class="price-separator">–</span>
                <div class="price-input">
                  <label>Max price</label>
                  <input type="number" name="maxPrice" placeholder="Any" value="<%= maxPrice || '' %>" min="0" />
                </div>
              </div>
            </div>

            <!-- Show taxes toggle -->
            <div class="filter-section">
              <div class="tax-toggle-row">
                <div class="toggle-text">
                  <h4>Show total with taxes</h4>
                  <p>Display prices including all fees</p>
                </div>
                <label class="toggle-switch">
                  <input type="checkbox" id="taxSwitch" name="showTaxes" value="true" <%= showTaxesFlag ? 'checked' : '' %> />
                  <span class="toggle-slider"></span>
                </label>
              </div>
            </div>

            <div class="filter-actions">
              <button type="button" class="btn-reset" id="filterResetBtn">Reset all</button>
              <button type="submit" class="btn-apply">Show <%= listings.length %> stays</button>
            </div>
          </form>
        </aside>

        <!-- Listings Grid -->
        <section class="listings-section">
          <div class="listings-grid">
            <% listings.forEach(listing => { %>
              <%
                const listingPrice = Number(listing.price);
                const taxRate = 0.12;
                const totalPrice = showTaxesFlag ? listingPrice * (1 + taxRate) : listingPrice;
                const formattedListingPrice = !Number.isNaN(totalPrice)
                  ? Math.round(totalPrice).toLocaleString('en-IN')
                  : 'N/A';
                const defaultImage = 'https://images.unsplash.com/photo-1625505826533-5c80aca7d157?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80';
                const listingImage = listing.image && listing.image.url ? listing.image.url : listing.image;
                const optimizedCardImage = getCardImageUrl(listingImage) || listingImage;
              %>
              <article class="listing-card">
                <a href="/listings/<%= listing._id %>" class="card-link">
                  <div class="card-image">
                    <img
                      src="<%= optimizedCardImage || defaultImage %>"
                      alt="<%= listing.title %>"
                      loading="lazy"
                      onerror="this.onerror=null;this.src='<%= defaultImage %>'"
                    />
                    <% if (listing.category) { %>
                      <span class="card-category-badge"><%= listing.category %></span>
                    <% } %>
                    <button class="card-favorite" type="button" aria-label="Save to wishlist" onclick="event.preventDefault();">
                      <i class="fa-regular fa-heart"></i>
                    </button>
                    <div class="card-price">
                      <span class="price-amount">₹<%= formattedListingPrice %></span>
                      <span class="price-unit"> / night<% if (showTaxesFlag) { %> total<% } %></span>
                    </div>
                  </div>
                  <div class="card-content">
                    <span class="card-location"><%= listing.location %>, <%= listing.country %></span>
                    <h3 class="card-title"><%= listing.title %></h3>
                    <div class="card-footer">
                      <span class="card-rating">
                        <i class="fa-solid fa-star"></i>
                        New
                      </span>
                    </div>
                  </div>
                </a>
              </article>
            <% }) %>
          </div>
        </section>
      </div>

    <% } %>
  </div>
</main>

<!-- Backdrop outside layout -->
<div class="filters-backdrop" id="filtersBackdrop" aria-hidden="true"></div>

<!-- Filters JS is /public/js/listings/filters.js -->
