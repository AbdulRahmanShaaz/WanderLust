<%
layout('layouts/boilerplate');
  pageTitle = `WanderLust | Edit ${listing.title}`;
  pageCss = '/css/listings/form.css';
  pageScript = '/js/form-validation.js';
%>
<main class="form-page-container">
  <div class="form-header-wrapper">
    <span class="eyebrow">Listing management</span>
    <h1>Refine the stay before guests see it</h1>
    <p>Edit the content that drives trust: title, location, pricing, imagery, and the property story.</p>
  </div>

  <div class="form-card">
    <form action="/listings/<%= listing._id %>?_method=PUT" method="POST" enctype="multipart/form-data" class="premium-form validated-form" novalidate>
      
      <div class="field-group">
        <label for="title">Listing title</label>
        <input type="text" id="title" name="listing[title]" value="<%= listing.title %>" required minlength="5" />
        <span class="field-hint">Keep it specific and easy to scan.</span>
      </div>

      <div class="field-group">
        <label for="description">Description</label>
        <textarea id="description" name="listing[description]" required minlength="20"><%= listing.description %></textarea>
        <span class="field-hint">Explain the setting, comfort, privacy, and standout details.</span>
      </div>

      <div class="form-row split">
        <div class="field-group">
          <label for="location">Location</label>
          <input type="text" id="location" name="listing[location]" value="<%= listing.location %>" required />
        </div>
        <div class="field-group">
          <label for="country">Country</label>
          <input type="text" id="country" name="listing[country]" value="<%= listing.country %>" required />
        </div>
      </div>

      <div class="field-group">
        <label for="price">Price per night</label>
        <input type="number" id="price" name="listing[price]" value="<%= listing.price %>" required min="0" step="1" />
        <span class="field-hint">Enter the amount in rupees (₹).</span>
      </div>

      <div class="field-group">
        <label>What best describes your place?</label>
        <input type="hidden" id="category" name="listing[category]" value="<%= listing.category || '' %>" required />
        <div class="category-picker" id="categoryPicker">
          <button type="button" class="category-card <%= listing.category === 'Beachfront' ? 'selected' : '' %>" data-value="Beachfront">
            <div class="category-card-icon"><i class="fa-solid fa-umbrella-beach"></i></div>
            <span class="category-card-label">Beachfront</span>
          </button>
          <button type="button" class="category-card <%= listing.category === 'City' ? 'selected' : '' %>" data-value="City">
            <div class="category-card-icon"><i class="fa-solid fa-city"></i></div>
            <span class="category-card-label">City</span>
          </button>
          <button type="button" class="category-card <%= listing.category === 'Mountain' ? 'selected' : '' %>" data-value="Mountain">
            <div class="category-card-icon"><i class="fa-solid fa-mountain-sun"></i></div>
            <span class="category-card-label">Mountain</span>
          </button>
          <button type="button" class="category-card <%= listing.category === 'Countryside' ? 'selected' : '' %>" data-value="Countryside">
            <div class="category-card-icon"><i class="fa-solid fa-tractor"></i></div>
            <span class="category-card-label">Countryside</span>
          </button>
          <button type="button" class="category-card <%= listing.category === 'Luxury' ? 'selected' : '' %>" data-value="Luxury">
            <div class="category-card-icon"><i class="fa-solid fa-gem"></i></div>
            <span class="category-card-label">Luxury</span>
          </button>
          <button type="button" class="category-card <%= listing.category === 'Budget' ? 'selected' : '' %>" data-value="Budget">
            <div class="category-card-icon"><i class="fa-solid fa-piggy-bank"></i></div>
            <span class="category-card-label">Budget</span>
          </button>
        </div>
        <span class="field-hint">Pick the one that guests would expect when booking your property.</span>
      </div>

      <div class="form-row split">
        <div class="field-group">
          <label>Current listing image</label>
          <div class="current-image-preview">
            <% const defaultImage = 'https://images.unsplash.com/photo-1625505826533-5c80aca7d157?ixlib=rb-4.0.3&auto=format&fit=crop&w=1200&q=80'; const listingImage = listing.image && listing.image.url ? listing.image.url : listing.image; %>
            <img src="<%= listingImage || defaultImage %>" alt="Current listing image" class="preview-img" />
          </div>
          <label for="image" class="file-upload-label">
            <i class="fa-solid fa-upload"></i>
            <span>Replace listing image</span>
            <input type="file" id="image" name="image" accept="image/*" class="file-input-hidden" />
          </label>
          <span class="field-hint">Or leave empty to keep the current image.</span>
        </div>
      </div>

      <div class="form-actions">
        <a href="/listings/<%= listing._id %>" class="btn-secondary">Cancel</a>
        <button type="submit" class="btn-primary">Save changes</button>
      </div>

    </form>
  </div>
</main>
